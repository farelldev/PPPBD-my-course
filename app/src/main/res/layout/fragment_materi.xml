<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="24dp"
    android:paddingVertical="8dp"
    android:orientation="vertical"
    tools:context=".HomeFragment">

    <TextView
        android:id="@+id/materi_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"

        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="16dp"
        android:text="Materi Kuliah"
        style="@style/FragmentTitle"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/materi_title"
        android:layout_marginTop="48dp">

        <androidx.constraintlayout.widget.ConstraintLayout
           style="@style/MateriContainer">
            <TextView
                android:id="@+id/materi1"
                style="@style/MateriTitle"
                android:text="1. Android Studio"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <TextView
                style="@style/MateriSubtitle"
                app:layout_constraintTop_toBottomOf="@id/materi1"
                app:layout_constraintStart_toStartOf="parent"
                android:text="Durasi: 45 Menit • Progress: 100%"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:src="@drawable/arrow_right"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            style="@style/MateriContainer">
            <TextView
                android:id="@+id/materi2"
                style="@style/MateriTitle"
                android:text="2. Linear Layout"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <TextView
                style="@style/MateriSubtitle"
                app:layout_constraintTop_toBottomOf="@id/materi2"
                app:layout_constraintStart_toStartOf="parent"
                android:text="Durasi: 50 Menit • Progress: 100%"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:src="@drawable/arrow_right"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            style="@style/MateriContainer">
            <TextView
                android:id="@+id/materi3"
                style="@style/MateriTitle"
                android:text="3. Relative &amp; Contraint Layout"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <TextView
                style="@style/MateriSubtitle"
                app:layout_constraintTop_toBottomOf="@id/materi3"
                app:layout_constraintStart_toStartOf="parent"
                android:text="Durasi: 45 Menit • Progress: 100%"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:src="@drawable/arrow_right"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            style="@style/MateriContainer">
            <TextView
                android:id="@+id/materi4"
                style="@style/MateriTitle"
                android:text="4. Activity &amp; Intent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <TextView
                style="@style/MateriSubtitle"
                app:layout_constraintTop_toBottomOf="@id/materi4"
                app:layout_constraintStart_toStartOf="parent"
                android:text="Durasi: 45 Menit • Progress: 100%"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:src="@drawable/arrow_right"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            style="@style/MateriContainer">
            <TextView
                android:id="@+id/materi5"
                style="@style/MateriTitle"
                android:text="5. UI Component"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <TextView
                style="@style/MateriSubtitle"
                app:layout_constraintTop_toBottomOf="@id/materi5"
                app:layout_constraintStart_toStartOf="parent"
                android:text="Durasi: 45 Menit • Progress: 100%"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:src="@drawable/arrow_right"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            style="@style/MateriContainer">
            <TextView
                android:id="@+id/materi6"
                style="@style/MateriTitle"
                android:text="6. Style, Option Menu, Tabs Layout"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <TextView
                style="@style/MateriSubtitle"
                app:layout_constraintTop_toBottomOf="@id/materi6"
                app:layout_constraintStart_toStartOf="parent"
                android:text="Durasi: 45 Menit • Progress: 60%"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:src="@drawable/arrow_right"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>