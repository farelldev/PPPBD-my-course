<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="24dp"
    android:paddingVertical="8dp"
    tools:context=".QuizFragment">

    <TextView
        android:id="@+id/quiz_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="16dp"
        android:text="Quiz Page"
        style="@style/FragmentTitle"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/quiz_title"
        android:background="@drawable/gray_outline"
        android:paddingBottom="16dp"
        android:layout_marginTop="48dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/quiz_thumbnail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:src="@drawable/thumbnail_quiz"
            app:shapeAppearanceOverlay="@style/RoundedTopCorner"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
        <TextView
            android:id="@+id/quiz_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/quiz_thumbnail"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/MateriTitle"
            android:text="Quiz PPPBD Pre-UTS"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"/>
        <TextView
            android:id="@+id/desc_quiz"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/quiz_name"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:text="Anda bleum mengambil quiz ini."
            style="@style/MateriSubtitle"
            android:textStyle="italic"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/quiz_name"
            style="@style/MateriSubtitle"
            android:text="Waktu: 90 menit"
            android:layout_marginEnd="16dp"/>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_open_quiz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kerjakan Quiz"
            app:layout_constraintTop_toBottomOf="@id/desc_quiz"
            android:padding="1dp"
            style="@style/CustomRoundedButton"
            android:layout_marginTop="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>